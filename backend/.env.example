# Paystack Credentials (Test Mode First)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Database Configuration (Neon PostgreSQL Cloud Database supported!)
# Standard Local URL: postgres://postgres:postgres@localhost:5432/skrillpay
# Neon Cloud URL: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxx@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# JWT Authentication (change JWT_SECRET before going to production!)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Webhook Security (used to sign events forwarded to merchant webhook URLs)
PLATFORM_WEBHOOK_SECRET=platform_webhook_hmac_secret_change_in_production

# KYC Provider Configuration
# Options: internal | prembly | smile_identity | youverify
# Use 'internal' for MVP (manual admin review, no external API needed)
KYC_PROVIDER=internal

# Prembly / Identitypass (https://prembly.com) — set if KYC_PROVIDER=prembly
PREMBLY_API_KEY=
PREMBLY_APP_ID=

# Smile Identity (https://smileidentity.com) — set if KYC_PROVIDER=smile_identity
SMILE_PARTNER_ID=
SMILE_API_KEY=

# Youverify (https://youverify.co) — set if KYC_PROVIDER=youverify
YOUVERIFY_API_KEY=

