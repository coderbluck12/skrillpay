# Korapay Credentials (Get from merchant.korapay.com)
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Legacy Paystack Credentials (Optional fallback)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Database Configuration (Neon PostgreSQL Cloud Database supported!)
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxx@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Webhook Security (HMAC SHA-512 secret for forwarding events to merchant webhooks)
PLATFORM_WEBHOOK_SECRET=platform_webhook_hmac_secret_change_in_production

# KYC Provider Configuration
# Options: korapay | internal
KYC_PROVIDER=korapay
